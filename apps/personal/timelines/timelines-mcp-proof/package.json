{
  "name": "timelines-mcp-proof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/cli.js serve",
    "owner": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && esbuild src/bridge.ts --bundle --platform=node --format=esm --packages=bundle --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=plugins/timelines-fixture/dist/bridge.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-test": "workspace:*",
    "@repo/config-ts": "workspace:*",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
