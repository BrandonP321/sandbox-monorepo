{
  "name": "wedding-website-infra",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"console.log('No dev server for infra.')\"",
    "synth": "cdk synth",
    "diff": "cdk diff --no-change-set",
    "deploy": "cdk deploy && pnpm --filter wedding-website-infra run publish:web",
    "deploy:ci": "cdk deploy --require-approval never && pnpm --filter wedding-website-infra run publish:web",
    "deploy:ci:no-build": "cdk deploy --require-approval never",
    "publish:web": "node ../../../../scripts/publish-spa-assets.mjs --stack-name WeddingWebsiteStack --web-filter wedding-website-web --dist-path ../../../../apps/personal/wedding-website/wedding-website-web/dist",
    "destroy": "cdk destroy",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/infra-patterns": "workspace:*",
    "@repo/wedding-website-shared": "workspace:*",
    "aws-cdk-lib": "^2.212.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-test": "workspace:*",
    "@repo/config-ts": "workspace:*",
    "@types/node": "^24.1.0",
    "aws-cdk": "^2.212.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
