{
  "name": "signal-tracker-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/local-dev.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.local.config.ts",
    "db:migrate:local": "drizzle-kit migrate --config=drizzle.local.config.ts",
    "db:migrate:deployed": "drizzle-kit migrate --config=drizzle.deployed.config.ts",
    "db:smoke:deployed": "tsx scripts/db-smoke-deployed.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1037.0",
    "@repo/api-core": "workspace:*",
    "@repo/postman-sync": "workspace:*",
    "@repo/signal-tracker-shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-test": "workspace:*",
    "@repo/config-ts": "workspace:*",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
