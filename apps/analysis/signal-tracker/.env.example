# Local API AWS access
# AWS_PROFILE=sandbox-admin
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# Database stage
# Defaults to prod when omitted.
# TODO: Change local development to SIGNAL_TRACKER_DB_STAGE=dev when the dev DB exists.
# SIGNAL_TRACKER_DB_STAGE=prod

# Optional one-off override for debugging a specific Aurora Data API target.
# Normally prefer SIGNAL_TRACKER_DB_STAGE instead of these values.
# SIGNAL_TRACKER_DB_NAME=signal_tracker
# SIGNAL_TRACKER_DB_RESOURCE_ARN=arn:aws:rds:us-east-1:498283327683:cluster:<cluster-name>
# SIGNAL_TRACKER_DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:498283327683:secret:<secret-name>
